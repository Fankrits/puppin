{
  "name": "puppin",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun --filter @puppin/web dev",
    "build": "bun --filter @puppin/web build",
    "preview": "bun --filter @puppin/web preview",
    "check": "bun --filter @puppin/web check",
    "generate-routes": "bun --filter @puppin/web generate-routes"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
