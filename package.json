{
  "name": "puppin",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:web": "bun --filter @puppin/web dev",
    "build:web": "bun --filter @puppin/web build",
    "preview:web": "bun --filter @puppin/web preview",
    "check:web": "bun --filter @puppin/web check",
    "generate-routes": "bun --filter @puppin/web generate-routes",
    "dev:medusa": "bun --filter @puppin/medusa dev",
    "build:medusa": "bun --filter @puppin/medusa build",
    "start:medusa": "bun --filter @puppin/medusa start",
    "db:up": "podman compose up -d",
    "db:down": "podman compose down",
    "db:setup": "bun --filter @puppin/medusa db:setup",
    "db:migrate": "bun --filter @puppin/medusa db:migrate",
    "user:medusa": "bun --filter @puppin/medusa user",
    "check": "bun --filter @puppin/web check",
    "test": "bun test",
    "test:medusa": "bun --filter @puppin/medusa test",
    "test:web": "bun --filter @puppin/web test",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "dev": "bun --filter '*' dev",
    "build": "bun --filter '*' build"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "packageManager": "bun@1.4.3"
}
